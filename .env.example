# =========================================================================
# CONVERA (SIH26264) Environment Configuration
# =========================================================================
# By default, CONVERA operates in zero-configuration standalone DEMO MODE
# using browser LocalStorage with pre-seeded AICTE institutions and cases.
#
# To connect CONVERA to a secure multi-user Supabase / PostgreSQL backend,
# configure your project credentials below.
#
# NOTE: Only the public Anon Key is used on the frontend.
# NEVER place your Supabase service_role secret key in frontend environment variables.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
